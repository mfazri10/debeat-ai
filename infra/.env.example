# ============================================================
# DebateAI Infrastructure & Microservices Environment
# ============================================================

# Database & Cache
POSTGRES_DB=debateai_dev
POSTGRES_USER=debateai
POSTGRES_PASSWORD=secret
DATABASE_URL=postgres://debateai:secret@postgres:5432/debateai_dev?sslmode=disable
REDIS_URL=redis://redis:6379

# Security
JWT_SECRET=super-secret-jwt-key-debateai-2026
NEXTAUTH_SECRET=super-secret-nextauth-key-2026

# AI Engine Providers (Minimal isi GEMINI_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Services Port & Address
PORT=8080
GRPC_PORT=50051
DEBATE_ENGINE_ADDR=debate-engine:50051
NEXT_PUBLIC_API_URL=http://localhost:8080/v1
