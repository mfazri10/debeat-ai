APP_ENV=development
GRPC_PORT=50051

# Database
DATABASE_URL=postgres+asyncpg://debateai:secret@localhost:5432/debateai_dev

# Redis
REDIS_URL=redis://localhost:6379

# AI Providers — Isi dengan API key kamu
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding
EMBEDDING_MODEL=gemini
EMBEDDING_DIMENSION=768

# RAG Config
RAG_TOP_K=5
RAG_THRESHOLD=0.75
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# AI Defaults
DEFAULT_AI_PROVIDER=GEMINI
AI_TIMEOUT_SECONDS=30
AI_CIRCUIT_BREAKER_THRESHOLD=3
