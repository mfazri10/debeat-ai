APP_ENV=development
PORT=8080

# Database
DATABASE_URL=postgres://debateai:secret@localhost:5432/debateai_dev?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# gRPC — Debate Engine
DEBATE_ENGINE_ADDR=localhost:50051

# Auth
JWT_SECRET=change-me-to-a-strong-random-secret-min-32-chars
JWT_EXPIRY_MINUTES=15
REFRESH_EXPIRY_DAYS=30

# Free Tier Limit
FREE_SESSIONS_PER_DAY=5

# AI Providers — Isi dengan API key kamu
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Storage — Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=debateai-dev

# Payment — Midtrans Sandbox
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_SANDBOX=true
